# Copy this file to .env. Never commit .env.
#
# EVERY KEY BELOW IS OPTIONAL. With nothing filled in, PayPilot runs in DEMO MODE:
# seeded demo data and a scripted AI, so you can click through the whole story.
# Add a key to switch on the real thing.

# ---- PayPal SANDBOX (developer.paypal.com > Apps & Credentials > Sandbox) ----
# Use a US sandbox Business account for the app and a US sandbox Personal account as the buyer.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# ---- AI (set one or both; they are tried in this order, then the scripted AI) ----
# Which provider to try first: nvidia or gemini.
LLM_PROVIDER=nvidia

# NVIDIA NIM (build.nvidia.com, free developer credits)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_FALLBACK_MODEL=mistralai/mistral-large-4-1t-a52b

# Google Gemini (aistudio.google.com, free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# ---- Optional tuning ----
PORT=3001
# Where the SQLite database lives (use :memory: for a throwaway run)
# DB_PATH=data/paypilot.db
# Give up on a slow AI request after this many milliseconds, then try the next model
# LLM_TIMEOUT_MS=12000
# Reasoning models spend part of this budget thinking; keep it generous
# NVIDIA_MAX_TOKENS=2500
# After this many minutes away, a returning customer's chat is flagged so the AI re-checks facts
# RESUME_AFTER_MIN=30
