# Copy to .env and fill in. Never commit .env.
# PayPal SANDBOX credentials only (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Leave keys empty to run in DEMO MODE (seeded data + deterministic mock agent)
PORT=3001

# Gemini (free tier works). The server tries GEMINI_MODEL, then GEMINI_FALLBACK_MODEL, then the scripted demo AI.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
